# PRIME Search — copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed; .claude/hooks/ blocks a commit
# that stages it or that contains a key-shaped string. Keys are read only from the
# environment and are never logged (docs/01 §8).

# ---------- Required ----------
# https://app.tavily.com  — key starts with tvly-
TAVILY_API_KEY=
# https://studio.nebius.com  — Token Factory API key
NEBIUS_API_KEY=

# ---------- Tracing (recommended: the bench report links to LangSmith) ----------
# https://smith.langchain.com  — key starts with lsv2_
# These two stay unprefixed: the langsmith SDK reads them from os.environ itself.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=prime-search

# ---------- Optional overrides (PRIME_ prefix, __ for nested fields) ----------
# The name after __ must be the field name exactly. PRIME_MODELS__SUBAGENT works;
# PRIME_MODELS__SUB is not a field and has no effect. A mistyped PRIME_ variable is
# reported as a warning on startup rather than silently dropped.
#
# Model routing — docs/01 §4. The defaults live in prime_search/config.py; leave these
# commented so a change there is not silently overridden here. Uncomment one only to
# override it deliberately. `make smoke` decides fallbacks; never switch silently.
#PRIME_MODELS__ROOT=nvidia/nemotron-3-super-120b-a12b
#PRIME_MODELS__CRITIC=nvidia/nemotron-3-super-120b-a12b
#PRIME_MODELS__SUBAGENT=moonshotai/Kimi-K2.6
#PRIME_MODELS__JUDGE=deepseek-ai/DeepSeek-V4-Flash-0731
#PRIME_MODELS__EXTRACTOR=moonshotai/Kimi-K2.6
#PRIME_MODELS__EVALUATOR=moonshotai/Kimi-K2.6
# baseline is the starter's model — do not change (CLAUDE.md)
#PRIME_MODELS__BASELINE=moonshotai/Kimi-K2.6

# Budgets — docs/01 §3
#PRIME_BUDGET_DEEP__MAX_SEARCHES=30
#PRIME_BUDGET_DEEP__MAX_SECONDS=180
#PRIME_BUDGET_FAST__MAX_SEARCHES=3

# API server — docs/01 §2. `make dev-api` / `python -m prime_search.api` listen here;
# the UI's /api proxy must use the same port.
#PRIME_API_HOST=127.0.0.1
#PRIME_API_PORT=8765

# Tavily response cache (on by default; keeps bench and GEPA re-runs comparable)
#PRIME_TAVILY_CACHE=true
#PRIME_TAVILY_CACHE_DIR=.cache/tavily

# Logging — read directly by prime_search/tracing.py, not through Settings, so
# logging works even when config validation fails.
#PRIME_LOG_LEVEL=INFO
#PRIME_LOG_JSON=false

# Credentials also accept the prefixed form, which wins if both are set:
#PRIME_TAVILY_API_KEY=
#PRIME_NEBIUS_API_KEY=
