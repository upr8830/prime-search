{
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv add*)",
      "Bash(make *)",
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(curl http://localhost:*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Edit(.env)",
      "Write(.env)",
      "Read(../starter_agent.py)",
      "Bash(git push --force*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/guard-paths.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/guard-commit.sh" }
        ]
      }
    ]
  }
}
